# Terraform state - contains resource IDs and potentially sensitive data
*.tfstate
*.tfstate.*
*.tfstate.backup

# Provider plugin cache
.terraform/
# Commit .terraform.lock.hcl to preserve provider versions and checksums.

# Plan output files
*.tfplan
tfplan

# Variable files that may contain secrets (keep terraform.tfvars tracked
# only if you're certain it has no secrets - otherwise use .tfvars.example)
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# SSH keys - never commit these
*.pem
*.key

# OS files
.DS_Store

notes.md
scalable-aws-vpc-project-guidance.md
keys/

# Local credentials and shell secrets
.aws/
.env
.env.*
!.env.example
